#!/usr/bin/env python3
"""Fake `claude -p --input-format stream-json` for tests.

Prompts: "plain:<text>", "tool", "hang", "crash", "args".
"""
import json, sys

args = sys.argv[1:]
sid = args[args.index("--resume") + 1] if "--resume" in args else "fake-session-1"
cost = 0.0
req = 0


def out(o):
    print(json.dumps(o), flush=True)


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line else None


def result(subtype="success", add=0.01):
    global cost
    cost += add
    out({"type": "result", "subtype": subtype, "is_error": subtype != "success",
         "session_id": sid, "total_cost_usd": round(cost, 6), "duration_ms": 5,
         "usage": {"input_tokens": 10, "output_tokens": 5, "cache_read_input_tokens": 100,
                   "cache_creation_input_tokens": 1}})


def text(t):
    out({"type": "assistant", "session_id": sid,
         "message": {"role": "assistant", "content": [{"type": "text", "text": t}]}})


while True:
    m = read()
    if m is None:
        break
    if m.get("type") == "control_request" and m["request"]["subtype"] == "initialize":
        out({"type": "control_response", "response": {"subtype": "success", "request_id": m["request_id"],
             "response": {"account": {"email": "someone@example.com"}, "commands": []}}})
        continue
    if m.get("type") != "user":
        continue
    prompt = m["message"]["content"]
    out({"type": "system", "subtype": "init", "session_id": sid, "model": "fake"})
    if prompt.startswith("plain:"):
        text(prompt[6:])
        result()
    elif prompt == "args":
        text(json.dumps(args))
        result()
    elif prompt == "crash":
        sys.exit(3)
    elif prompt == "tool":
        req += 1
        rid = f"req-{req}"
        out({"type": "assistant", "session_id": sid, "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "tu1", "name": "Write", "input": {"file_path": "/x", "content": "y"}}]}})
        out({"type": "control_request", "request_id": rid, "request": {
            "subtype": "can_use_tool", "tool_name": "Write", "input": {"file_path": "/x", "content": "y"},
            "description": "x", "tool_use_id": "tu1",
            "permission_suggestions": [{"type": "setMode", "mode": "acceptEdits", "destination": "localSettings"}]}})
        r = read()
        resp = r["response"]["response"]
        ok = r["response"]["request_id"] == rid and resp["behavior"] == "allow"
        out({"type": "user", "session_id": sid, "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "tu1", "is_error": not ok,
             "content": json.dumps(resp)}]}})
        result()
    elif prompt == "hang":
        text("working")
        r = read()
        if r and r.get("request", {}).get("subtype") == "interrupt":
            out({"type": "control_response", "response": {"subtype": "success",
                 "request_id": r["request_id"], "response": {}}})
            out({"type": "user", "session_id": sid, "message": {"role": "user", "content": [
                {"type": "text", "text": "[Request interrupted by user]"}]}})
            result("error_during_execution", 0)
