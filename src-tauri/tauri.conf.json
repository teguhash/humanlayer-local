{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HumanLayer Local",
  "version": "0.1.0",
  "identifier": "dev.teguh.humanlayerlocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HumanLayer Local",
        "width": 1100,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/rpi/": "rpi/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOTlFQTcxRDNCODE2OTMKUldTVEZyalRjZXFaYk43eU9GVVFmSm5sd0ZLVG5Qc2RTMzJxNFp4aWFUTk5IVnNiTW9zcjhQOVAK",
      "endpoints": [
        "https://github.com/teguhash/humanlayer-local/releases/latest/download/latest.json"
      ]
    }
  }
}
